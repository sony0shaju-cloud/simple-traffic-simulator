import mesa
import time
import random
from IPython.display import clear_output
from tabulate import tabulate # For the fancy scoreboard

# --- 1. CONFIGURATION ---
GRID_SIZE = 15       # Bigger map for trees
CENTER = 7           # Middle lane
INTERSECTION = (CENTER, CENTER)

# --- 2. AGENTS ---

class Tree(mesa.Agent):
    """A decorative tree to make it look like the image."""
    def __init__(self, model):
        super().__init__(model)

class SignalPole(mesa.Agent):
    """A Signal Pole that sits on the sidewalk (GRASS), not the road."""
    def __init__(self, model, direction_controlled):
        super().__init__(model)
        self.direction = direction_controlled # "Horizontal" or "Vertical"
        self.color = "🔴" # Default Red

class Car(mesa.Agent):
    def __init__(self, model, icon, name, direction, start_pos):
        super().__init__(model)
        self.icon = icon
        self.name = name
        self.direction = direction
        self.wait_time = 0
        self.rating = 10.0
        self.finished = False
        
        # Determine movement delta
        if direction == "Right": self.dx, self.dy = (1, 0)
        elif direction == "Up":  self.dx, self.dy = (0, 1)

    def step(self):
        if self.finished: return

        x, y = self.pos
        next_pos = (x + self.dx, y + self.dy)

        # 1. Check Destination (Despawn)
        if not (0 <= next_pos[0] < GRID_SIZE and 0 <= next_pos[1] < GRID_SIZE):
            self.finished = True
            self.model.grid.remove_agent(self)
            self.model.agents.remove(self)
            self.model.completed_cars.append(self)
            return

        # 2. Logic: Should I stop?
        should_stop = False
        
        # A. Check Traffic Lights
        # We look at the Model's global signal state
        # If I am entering the intersection...
        dist_to_center = abs(x - CENTER) + abs(y - CENTER)
        
        # If I am 1 step away from the Intersection box
        is_at_stop_line = False
        if self.direction == "Right" and x == CENTER - 1: is_at_stop_line = True
        if self.direction == "Up"    and y == CENTER - 1: is_at_stop_line = True
        
        if is_at_stop_line:
            # Check the global signal state
            if self.direction == "Right" and self.model.signal_state == "Vertical_Green":
                should_stop = True
            if self.direction == "Up" and self.model.signal_state == "Horizontal_Green":
                should_stop = True

        # B. Check Car Ahead (Collision Prevention)
        cell_ahead = self.model.grid.get_cell_list_contents([next_pos])
        for obj in cell_ahead:
            if isinstance(obj, Car): should_stop = True

        # 3. Execute
        if should_stop:
            self.wait_time += 1
            # Decrease rating (Max 10, Min 1)
            self.rating = max(1.0, 10.0 - (self.wait_time * 0.5))
        else:
            self.model.grid.move_agent(self, next_pos)

# --- 3. THE MODEL ---

class GameMapModel(mesa.Model):
    def __init__(self):
        super().__init__()
        self.grid = mesa.space.MultiGrid(GRID_SIZE, GRID_SIZE, torus=False)
        self.step_count = 0
        
        # Signal State
        self.signal_state = "Horizontal_Green"
        self.signal_timer = 0
        
        # Data storage
        self.completed_cars = []

        # --- BUILD THE MAP (Trees & Poles) ---
        for x in range(GRID_SIZE):
            for y in range(GRID_SIZE):
                
                # If it's NOT a road...
                if x != CENTER and y != CENTER:
                    # 1. Place Signal Poles at Corners
                    if (x == CENTER-1 and y == CENTER-1): 
                        self.pole_h = SignalPole(self, "Horizontal")
                        self.grid.place_agent(self.pole_h, (x,y))
                    elif (x == CENTER+1 and y == CENTER+1):
                        self.pole_v = SignalPole(self, "Vertical")
                        self.grid.place_agent(self.pole_v, (x,y))
                    
                    # 2. Place Trees randomly
                    elif random.random() < 0.3: 
                        t = Tree(self)
                        self.grid.place_agent(t, (x,y))

    def step(self):
        self.step_count += 1
        
        # 1. Signal Logic (Switch every 6 ticks)
        self.signal_timer += 1
        if self.signal_timer > 6:
            self.signal_timer = 0
            if self.signal_state == "Horizontal_Green":
                self.signal_state = "Vertical_Green"
            else:
                self.signal_state = "Horizontal_Green"
        
        # Update Pole Colors
        self.pole_h.color = "🟢" if self.signal_state == "Horizontal_Green" else "🔴"
        self.pole_v.color = "🟢" if self.signal_state == "Vertical_Green" else "🔴"

        # 2. Spawn Cars (Wave Logic)
        if self.step_count == 1:
            self.add_car("🏎️", "Red Racer", "Right", (0, CENTER))
        if self.step_count == 3:
            self.add_car("🚙", "Blue Van", "Up", (CENTER, 0))
        if self.step_count == 8:
            self.add_car("🚕", "Taxi", "Right", (0, CENTER))
        if self.step_count == 12:
            self.add_car("🚑", "Ambulance", "Up", (CENTER, 0))

        # 3. Move Agents
        self.agents.shuffle_do("step")

    def add_car(self, icon, name, direction, pos):
        if self.grid.is_cell_empty(pos):
            c = Car(self, icon, name, direction, pos)
            self.grid.place_agent(c, pos)
            self.agents.add(c)

    def print_game_state(self):
        # A. PRINT MAP
        print(f"⏱️ TIME: {self.step_count} | SIGNAL MODE: {self.signal_state}\n")
        
        for y in range(GRID_SIZE-1, -1, -1):
            row = ""
            for x in range(GRID_SIZE):
                cell = self.grid.get_cell_list_contents([(x,y)])
                
                # Base Terrain
                if x == CENTER or y == CENTER:
                    symbol = "⬛" # Road
                    if x == CENTER and y == CENTER: symbol = "🔲" # Intersection
                else:
                    symbol = "🟩" # Grass
                
                # Overwrite with Agents
                for obj in cell:
                    if isinstance(obj, Tree): symbol = "🌲"
                    if isinstance(obj, SignalPole): symbol = obj.color
                    if isinstance(obj, Car): symbol = obj.icon
                
                row += symbol
            print(row)

        # B. PRINT SCOREBOARD
        print("\n--- 🏁 LIVE VEHICLE TRACKER ---")
        
        # Gather data from Active cars + Finished cars
        all_cars = []
        
        # Active Cars
        for agent in self.agents:
            if isinstance(agent, Car):
                status = "Driving 💨" if agent.wait_time == 0 else "Waiting 🛑"
                all_cars.append([agent.icon, agent.name, status, f"{agent.rating:.1f}/10"])
        
        # Finished Cars
        for car in self.completed_cars:
            all_cars.append([car.icon, car.name, "FINISHED ✅", f"{car.rating:.1f}/10"])

        print(tabulate(all_cars, headers=["Car", "Name", "Status", "Rating"], tablefmt="simple_grid"))

# --- 4. RUNNER ---
model = GameMapModel()

print("Starting Game Engine...")
time.sleep(1)

for i in range(40):
    model.step()
    clear_output(wait=True)
    model.print_game_state()
    time.sleep(0.4)
